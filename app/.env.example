# Postgres (Neon) — chaîne de connexion poolée
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Secret de session et de chiffrement des mots de passe SMTP (32+ caractères aléatoires)
SESSION_SECRET=change-me-with-a-long-random-string
# URL publique de l'application (liens de désinscription dans les emails)
APP_URL=https://relanceauto-app.vercel.app
# Optionnel : protège /api/cron (Vercel Cron envoie Authorization: Bearer <valeur>)
CRON_SECRET=
# Lien de prise de rendez-vous pour passer en illimité
UPGRADE_URL=https://cal.com/victor-francis-itoua-mveng-feg0dn/15min
